{
    "$schema": "https://tr.designtokens.org/format/",
    "$description": "Optimus Design-Tokens — die einzige Quelle der Wahrheit für Farben, Abstände, Schrift. NUR diese Datei bearbeiten. Marke: Crimson-Palette (vom User geliefert: Tint #EBC0C5, Light #C96773, Base #A32432, Dark #6E1822), Zwischenstufen interpoliert. Schrift: IBM Plex Sans. Standard-Modus: Hell. DESIGN-RICHTUNG (User, 2026-07-24): Glassmorphism — weicher heller Verlaufs-Hintergrund, halbtransparente 'Milchglas'-Kacheln (backdrop-blur), Rot NUR als Akzent (Buttons, Icons, Highlights), nicht als Flächenfarbe. Kontraste WCAG-AA-geprüft am 2026-07-24.",
  
    "primitive": {
      "$description": "Stufe 1 — Rohpalette. NIEMALS direkt in Komponenten verwenden.",
      "color": {
        "brand": {
          "50":  { "$type": "color", "$value": "#F8E9EB", "$description": "abgeleitet" },
          "100": { "$type": "color", "$value": "#EBC0C5", "$description": "= Tint (User). Soft fills, panels" },
          "200": { "$type": "color", "$value": "#E0A3AA", "$description": "abgeleitet" },
          "300": { "$type": "color", "$value": "#D5858F", "$description": "abgeleitet" },
          "400": { "$type": "color", "$value": "#C96773", "$description": "= Light (User). Secondary fills — Kontrast mit Weiss nur 3.7:1, NICHT für Fliesstext auf dieser Farbe" },
          "500": { "$type": "color", "$value": "#B64652", "$description": "abgeleitet" },
          "600": { "$type": "color", "$value": "#A32432", "$description": "= Base (User). Primary brand — Weiss darauf: 7.4:1 AA ok" },
          "700": { "$type": "color", "$value": "#881E2A", "$description": "abgeleitet — Hover auf Base" },
          "800": { "$type": "color", "$value": "#6E1822", "$description": "= Dark (User). Headers, depth — Weiss darauf: 11.6:1" },
          "900": { "$type": "color", "$value": "#491016", "$description": "abgeleitet" }
        },
        "neutral": {
          "0":   { "$type": "color", "$value": "#FFFFFF" },
          "50":  { "$type": "color", "$value": "#FAF7F8", "$description": "warmes Off-White, minimal zur Marke hin getönt" },
          "100": { "$type": "color", "$value": "#F1ECED" },
          "200": { "$type": "color", "$value": "#DFD7D9" },
          "400": { "$type": "color", "$value": "#A29699", "$description": "nur für Deko/Disabled, nicht für Text auf Weiss" },
          "600": { "$type": "color", "$value": "#6B5F62", "$description": "gedämpfter Text auf Weiss: AA ok" },
          "800": { "$type": "color", "$value": "#332C2E" },
          "900": { "$type": "color", "$value": "#1E191A" },
          "950": { "$type": "color", "$value": "#131011" }
        },
        "success": {
          "100": { "$type": "color", "$value": "#D8F3E3" },
          "600": { "$type": "color", "$value": "#177A46", "$description": "auf Weiss: AA ok" }
        },
        "warning": {
          "100": { "$type": "color", "$value": "#FDEECF" },
          "600": { "$type": "color", "$value": "#8A5A00", "$description": "auf Weiss: AA ok" }
        },
        "danger": {
          "$description": "BEWUSST ins Orange-Rote verschoben, damit Fehler-Zustände nicht mit der roten Markenfarbe verwechselt werden. Fehler zusätzlich IMMER mit Icon/Text kennzeichnen, nie nur über Farbe.",
          "100": { "$type": "color", "$value": "#FCE4D8" },
          "600": { "$type": "color", "$value": "#B33A00", "$description": "auf Weiss: AA ok" }
        }
      }
    },
  
    "semantic": {
      "$description": "Stufe 2 — die EINZIGEN Tokens, die Komponenten verwenden dürfen. Hell ist der Standard-Modus.",
      "light": {
        "color": {
          "background": {
            "default":  { "$type": "color", "$value": "{primitive.color.neutral.0}" },
            "subtle":   { "$type": "color", "$value": "{primitive.color.neutral.50}" },
            "canvas":   { "$type": "gradient", "$value": "linear-gradient(160deg, #FAF7F8 0%, #F8E9EB 45%, #F1ECED 100%)", "$description": "App-Hintergrund hinter den Glaskacheln: weicher, warmer Verlauf mit einem Hauch der Marken-Tint. Ersetzt den 'Raum' aus der Inspo." },
            "panel":    { "$type": "color", "$value": "{primitive.color.brand.50}", "$description": "zarte Markenfläche — nur als gezielter Akzent einsetzen" },
            "panelStrong": { "$type": "color", "$value": "{primitive.color.brand.100}", "$description": "= Tint — nur als gezielter Akzent (z. B. eine hervorgehobene Kachel), NICHT flächig" },
            "elevated": { "$type": "color", "$value": "{primitive.color.neutral.0}" }
          },
          "surface": {
            "$description": "Glassmorphism-Kacheln. IMMER zusammen mit effect.blur verwenden. Text darauf nur text.default/muted — Kontrast ist gegen den hellsten Punkt des canvas-Verlaufs gerechnet.",
            "glass":       { "$type": "color", "$value": "rgba(255,255,255,0.60)", "$description": "Standard-Kachel (KPI-Tiles, Cards)" },
            "glassStrong": { "$type": "color", "$value": "rgba(255,255,255,0.78)", "$description": "Kacheln mit viel Text/Daten — mehr Deckung = bessere Lesbarkeit" },
            "glassSubtle": { "$type": "color", "$value": "rgba(255,255,255,0.38)", "$description": "grosse Container/Seitenleiste, nur wenig direkter Text" },
            "glassBorder": { "$type": "color", "$value": "rgba(255,255,255,0.65)", "$description": "1px Innenkante, gibt den Glas-Look" }
          },
          "text": {
            "default": { "$type": "color", "$value": "{primitive.color.neutral.900}" },
            "muted":   { "$type": "color", "$value": "{primitive.color.neutral.600}" },
            "brand":   { "$type": "color", "$value": "{primitive.color.brand.600}", "$description": "AKZENT: betonte Werte, Links, aktive Icons — sparsam einsetzen" },
            "heading": { "$type": "color", "$value": "{primitive.color.neutral.900}", "$description": "Überschriften neutral-dunkel (Rot nur als Akzent, User-Entscheidung). brand.800 steht weiter für besondere Momente zur Verfügung." },
            "onBrand": { "$type": "color", "$value": "{primitive.color.neutral.0}" }
          },
          "border": {
            "default": { "$type": "color", "$value": "rgba(30,25,26,0.10)", "$description": "leichte, halbtransparente Trennlinien passend zum Glas-Look" },
            "brand":   { "$type": "color", "$value": "{primitive.color.brand.200}" }
          },
          "brand": {
            "default":   { "$type": "color", "$value": "{primitive.color.brand.600}" },
            "hover":     { "$type": "color", "$value": "{primitive.color.brand.700}" },
            "secondary": { "$type": "color", "$value": "{primitive.color.brand.400}", "$description": "= Light, 'Secondary fills' — nur Flächen/Deko/grosse Schrift, kein Fliesstext darauf" }
          },
          "status": {
            "success":       { "$type": "color", "$value": "{primitive.color.success.600}" },
            "successSubtle": { "$type": "color", "$value": "{primitive.color.success.100}" },
            "warning":       { "$type": "color", "$value": "{primitive.color.warning.600}" },
            "warningSubtle": { "$type": "color", "$value": "{primitive.color.warning.100}" },
            "danger":        { "$type": "color", "$value": "{primitive.color.danger.600}" },
            "dangerSubtle":  { "$type": "color", "$value": "{primitive.color.danger.100}" }
          },
          "focus": { "$type": "color", "$value": "{primitive.color.brand.600}", "$description": "Fokus-Ring für Tastatur-Navigation" }
        }
      },
      "dark": {
        "color": {
          "background": {
            "default":  { "$type": "color", "$value": "{primitive.color.neutral.950}" },
            "subtle":   { "$type": "color", "$value": "{primitive.color.neutral.900}" },
            "canvas":   { "$type": "gradient", "$value": "linear-gradient(160deg, #131011 0%, #1E1416 50%, #171314 100%)", "$description": "dunkler Verlauf mit einem Hauch Marken-Wärme" },
            "panel":    { "$type": "color", "$value": "{primitive.color.brand.900}" },
            "panelStrong": { "$type": "color", "$value": "{primitive.color.brand.800}" },
            "elevated": { "$type": "color", "$value": "{primitive.color.neutral.800}" }
          },
          "surface": {
            "glass":       { "$type": "color", "$value": "rgba(30,25,26,0.55)" },
            "glassStrong": { "$type": "color", "$value": "rgba(30,25,26,0.75)" },
            "glassSubtle": { "$type": "color", "$value": "rgba(30,25,26,0.35)" },
            "glassBorder": { "$type": "color", "$value": "rgba(255,255,255,0.12)" }
          },
          "text": {
            "default": { "$type": "color", "$value": "{primitive.color.neutral.50}" },
            "muted":   { "$type": "color", "$value": "{primitive.color.neutral.400}" },
            "brand":   { "$type": "color", "$value": "{primitive.color.brand.200}", "$description": "im Dunkelmodus hellere Markenstufe für Lesbarkeit" },
            "heading": { "$type": "color", "$value": "{primitive.color.brand.100}" },
            "onBrand": { "$type": "color", "$value": "{primitive.color.neutral.0}" }
          },
          "border": {
            "default": { "$type": "color", "$value": "{primitive.color.neutral.800}" },
            "brand":   { "$type": "color", "$value": "{primitive.color.brand.700}" }
          },
          "brand": {
            "default":   { "$type": "color", "$value": "{primitive.color.brand.500}" },
            "hover":     { "$type": "color", "$value": "{primitive.color.brand.400}" },
            "secondary": { "$type": "color", "$value": "{primitive.color.brand.700}" }
          },
          "status": {
            "success":       { "$type": "color", "$value": "#4ECB8B" },
            "successSubtle": { "$type": "color", "$value": "#0E3B23" },
            "warning":       { "$type": "color", "$value": "#E8A93D" },
            "warningSubtle": { "$type": "color", "$value": "#3D2E0A" },
            "danger":        { "$type": "color", "$value": "#F2764A" },
            "dangerSubtle":  { "$type": "color", "$value": "#40170A" }
          },
          "focus": { "$type": "color", "$value": "{primitive.color.brand.300}" }
        }
      }
    },
  
    "dimension": {
      "$description": "Abstände + Rundungen. Komponenten nutzen NUR diese Skala, nie rohe Pixelwerte.",
      "space": {
        "0": { "$type": "dimension", "$value": "0" },
        "1": { "$type": "dimension", "$value": "0.25rem" },
        "2": { "$type": "dimension", "$value": "0.5rem" },
        "3": { "$type": "dimension", "$value": "0.75rem" },
        "4": { "$type": "dimension", "$value": "1rem" },
        "6": { "$type": "dimension", "$value": "1.5rem" },
        "8": { "$type": "dimension", "$value": "2rem" },
        "12": { "$type": "dimension", "$value": "3rem" }
      },
      "radius": {
        "sm": { "$type": "dimension", "$value": "0.375rem" },
        "md": { "$type": "dimension", "$value": "0.5rem" },
        "lg": { "$type": "dimension", "$value": "0.75rem" },
        "full": { "$type": "dimension", "$value": "9999px" }
      }
    },
  
    "typography": {
      "$description": "Schrift: IBM Plex Sans (User-Entscheidung). Wird in Next.js über next/font/google geladen, NICHT über den <link>-Embed-Code — gleiche Schrift, aber selbst gehostet (besser für Datenschutz/GDPR und Ladezeit).",
      "fontFamily": {
        "sans": { "$type": "fontFamily", "$value": ["IBM Plex Sans", "system-ui", "sans-serif"] }
      },
      "fontSize": {
        "xs":  { "$type": "dimension", "$value": "0.75rem" },
        "sm":  { "$type": "dimension", "$value": "0.875rem" },
        "base":{ "$type": "dimension", "$value": "1rem" },
        "lg":  { "$type": "dimension", "$value": "1.125rem" },
        "xl":  { "$type": "dimension", "$value": "1.5rem" },
        "2xl": { "$type": "dimension", "$value": "2rem" }
      },
      "fontWeight": {
        "regular": { "$type": "fontWeight", "$value": 400 },
        "medium":  { "$type": "fontWeight", "$value": 500 },
        "semibold":{ "$type": "fontWeight", "$value": 600 }
      }
    },
  
    "shadow": {
      "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(19,16,17,0.06)" },
      "md": { "$type": "shadow", "$value": "0 4px 12px rgba(19,16,17,0.08)" },
      "glass": { "$type": "shadow", "$value": "0 8px 32px rgba(110,24,34,0.10)", "$description": "weicher, leicht markenwarmer Schatten unter Glaskacheln — gibt die schwebende Tiefe aus der Inspo" }
    },
  
    "effect": {
      "$description": "Glassmorphism-Effekte. blur wird als backdrop-filter auf surface.glass* gelegt.",
      "blur": {
        "sm": { "$type": "dimension", "$value": "8px", "$description": "kleine Elemente (Badges, Chips)" },
        "md": { "$type": "dimension", "$value": "16px", "$description": "Standard für Kacheln/Cards" },
        "lg": { "$type": "dimension", "$value": "28px", "$description": "grosse Container, Seitenleiste, Navigation" }
      },
      "transition": {
        "fast":   { "$type": "duration", "$value": "150ms", "$description": "Hover/Fokus" },
        "normal": { "$type": "duration", "$value": "250ms", "$description": "Ein-/Ausblenden, Panels" }
      }
    },
  
    "theme": {
      "$description": "App-Verhalten",
      "defaultMode": { "$type": "string", "$value": "light" }
    }
  }
  